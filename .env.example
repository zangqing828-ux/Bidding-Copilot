# Bidding Copilot Web v1 环境变量配置
# 复制此文件为 .env 并填入真实值

# 基础配置
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://your-domain.com
YIBIAO_DATA_DIR=/data

# OAuth 配置（生产必须使用 mainquest 模式）
OAUTH_MODE=mainquest
MAINQUEST_AUTH_BASE_URL=https://auth.mainquestai.top
MAINQUEST_OAUTH_CLIENT_ID=
MAINQUEST_OAUTH_CLIENT_SECRET=
MAINQUEST_OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/callback

# 会话密钥（生成随机字符串）
SESSION_SECRET=

# API Key 加密主密钥（生成随机字符串）
CONFIG_ENCRYPTION_KEY=

# 会话过期天数
SESSION_TTL_DAYS=7

# 上传限制
UPLOAD_MAX_SIZE_MB=50
