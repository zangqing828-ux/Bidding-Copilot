    "dev:web": "concurrently -k -n web,api -c blue,magenta \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env OAUTH_MODE=mock SESSION_SECRET=dev-secret node server/index.cjs\"",
    "predev:web": "npm rebuild better-sqlite3 --runtime=node",
    "build:web": "tsc --noEmit && vite build",
    "prestart:web": "npm rebuild better-sqlite3 --runtime=node",
    "start:web": "node server/index.cjs",
    "test:web-auth": "node scripts/test-web-auth.cjs",
    "test:web-single-tenant": "node scripts/test-web-single-tenant.cjs",
    "test:web-workspace": "node scripts/test-web-workspace.cjs",
