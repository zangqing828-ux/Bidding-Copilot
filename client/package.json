{
  "name": "yibiao-client",
  "version": "0.1.0",
  "private": true,
  "description": "易标投标工具箱独立桌面客户端",
  "author": "mark",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "generate-build-attestation": "node scripts/generate-build-attestation.cjs",
    "prepare-opencode-tools": "node scripts/prepare-opencode-tools.cjs",
    "verify-opencode-tools": "node scripts/verify-opencode-tools.cjs",
    "audit:production": "npm audit --omit=dev --audit-level=critical || node scripts/audit-production-dependencies.cjs",
    "smoke:electron-native": "electron --no-sandbox scripts/electron-native-smoke.cjs",
    "presmoke:electron-native": "npm rebuild better-sqlite3 --runtime=electron --target=41.10.2",
    "start": "electron .",
    "prestart": "npm rebuild better-sqlite3 --runtime=electron --target=41.10.2",
    "dev:web": "concurrently -k -n web,api -c blue,magenta \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env OAUTH_MODE=mock SESSION_SECRET=dev-secret node server/index.cjs\"",
    "predev:web": "npm rebuild better-sqlite3 --runtime=node",
    "build:web": "tsc --noEmit && vite build",
    "prestart:web": "npm rebuild better-sqlite3 --runtime=node",
    "start:web": "node server/index.cjs",
    "test:web-auth": "node scripts/test-web-auth.cjs",
    "test:web-workspace": "node scripts/test-web-workspace.cjs",
    "test:web-tasks": "node scripts/test-web-tasks.cjs",
    "test:web-files": "node scripts/test-web-files.cjs",
    "test:web-export": "node scripts/test-web-export.cjs",
    "test:web-browser": "playwright test",
    "test:web-agent-runtime": "node scripts/test-web-agent-runtime.cjs",
    "test:web-agent-protocol": "node scripts/test-web-agent-protocol.cjs",
    "test:web-agent-coordinator": "node scripts/test-web-agent-coordinator.cjs",
    "test:web-agent-executor": "node scripts/test-web-agent-executor.cjs",
    "test:web-agent-docker": "node scripts/test-web-agent-docker.cjs",
    "test:web-agent-sidecar": "npm run test:web-agent-sidecar-security && npm run test:web-agent-sidecar-e2e",
    "test:web-agent-sidecar-security": "node scripts/test-wp-j-sidecar-security.cjs && node scripts/test-wp-j-web-image-boundary.cjs",
    "test:web-agent-sidecar-e2e": "node scripts/test-wp-j-sidecar-protocol.cjs && node scripts/test-wp-j-sidecar-api.cjs",
    "test:web-agent-readiness": "node scripts/test-wp-j-readiness.cjs",
    "test:web-agent-runner-assets": "node scripts/test-wp-j-runner-assets.cjs",
    "test:web-image-boundary": "node scripts/test-wp-j-web-image-boundary.cjs",
    "test:opencode-checksum": "node scripts/test-opencode-checksum.cjs",
    "test:document-parser-limits": "node scripts/test-document-parser-limits.cjs",
    "test:web-graceful-shutdown": "node scripts/test-web-server-graceful-shutdown.cjs",
    "test:web-contract": "node scripts/test-web-contract.cjs",
    "test:web-contract:strict-guard": "node scripts/test-web-contract-strict-guard.cjs",
    "test:bid-analysis-contract": "node scripts/test-bid-analysis-contract.cjs",
    "test:electron-task-characterization": "node scripts/test-electron-task-characterization.cjs",
    "test:task-orchestrator": "node scripts/test-task-orchestrator.cjs",
    "test:workspace-mutation-executor": "node scripts/test-workspace-mutation-executor.cjs",
    "test:bid-analysis-cas": "node scripts/test-bid-analysis-cas.cjs",
    "test:web-bid-analysis": "node scripts/test-web-bid-analysis.cjs",
    "test:web-technical-plan-j1": "node scripts/test-web-technical-plan-j1.cjs",
    "test:web-technical-plan-browser": "playwright test e2e/web-technical-plan-browser.spec.cjs",
    "test:web-technical-plan-j2-browser": "playwright test e2e/web-technical-plan-j2-browser.spec.cjs",
    "test:wp-j:j1-foundation": "node scripts/test-wp-j-contract-task-dtos.cjs && node scripts/test-wp-j-contract-adapter-mapping.cjs && node scripts/test-wp-j-contract-state-projection.cjs && node scripts/test-wp-j-contract-run-manifest.cjs && node scripts/test-wp-j-contract-fixtures.cjs && node scripts/test-wp-j-characterization-sections.cjs && node scripts/test-wp-j-characterization-outlines.cjs && node scripts/test-wp-j-portable-sections.cjs && node scripts/test-wp-j-portable-bid-section-orchestration.cjs && node scripts/test-wp-j-portable-outline.cjs && node scripts/test-wp-j-portable-orchestration.cjs && node scripts/test-wp-j-store-cas.cjs",
    "wp-j:gate:j1": "npm run test:wp-j:j1-foundation && npm run test:bid-analysis-contract && npm run test:electron-task-characterization && npm run test:portable-core && npm run test:workspace-mutation-executor && npm run test:web-store-executor && npm run test:web-technical-plan-j1 && npm run build",
    "test:ai-scheduler": "node scripts/test-ai-scheduler.cjs",
    "test:web-endpoint-policy": "node scripts/test-web-endpoint-policy.cjs",
    "test:web-ai-runtime": "node scripts/test-web-ai-runtime.cjs",
    "test:web-analytics-identity": "node scripts/test-web-analytics-identity.cjs",
    "test:web-analytics-identity-retirement": "node scripts/test-analytics-legacy-migration.cjs",
    "test:portable-core": "node scripts/test-portable-core.cjs",
    "test:workspace-lifecycle": "node scripts/test-workspace-lifecycle.cjs",
    "test:web-workspace-registry": "node scripts/test-web-workspace-registry.cjs",
    "test:web-store-executor": "node scripts/test-web-store-executor.cjs",
    "test:wp-j:j2-core": "node scripts/test-wp-j-j2-core-global-facts.cjs && node scripts/test-wp-j-j2-core-content-generation.cjs && node scripts/test-wp-j-technical-plan-quality.cjs && node scripts/test-wp-j-j2-lifecycle.cjs",
    "wp-j:gate:j2": "npm run test:wp-j:j2-core && npm run test:web-contract && npm run test:web-contract:strict-guard && npm run test:portable-core && npm run build && npm run test:web-technical-plan-j2-browser",
    "wp-j:doctor": "node scripts/wp-j-doctor.cjs",
    "wp-j:readiness": "node scripts/wp-j-readiness.cjs",
    "wp-j:diagnose": "node scripts/wp-j-diagnose.cjs",
    "wp-j:rollback-smoke": "node scripts/wp-j-rollback-smoke.cjs",
    "test:web": "npm run test:portable-core && npm run test:task-orchestrator && npm run test:electron-task-characterization && npm run test:workspace-mutation-executor && npm run test:bid-analysis-contract && npm run test:bid-analysis-cas && npm run test:ai-scheduler && npm run test:web-endpoint-policy && npm run test:web-ai-runtime && npm run test:web-analytics-identity && npm run test:web-analytics-identity-retirement && npm run test:web-store-executor && npm run test:workspace-lifecycle && npm run test:web-workspace-registry && npm run test:web-graceful-shutdown && npm run test:web-auth && npm run test:web-workspace && npm run test:web-contract && npm run test:web-contract:strict-guard && npm run test:web-tasks && npm run test:web-bid-analysis && npm run test:web-files && npm run test:web-export && npm run test:web-agent-protocol && npm run test:web-agent-runtime && npm run test:web-agent-coordinator && npm run test:web-agent-executor && npm run test:opencode-checksum && npm run test:document-parser-limits"
  },
  "build": {
    "appId": "com.yibiao.openbidkit",
    "productName": "易标投标工具箱",
    "copyright": "Copyright © 2026 mark",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "shared/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/opencode",
        "to": "opencode",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/opencode-tools",
        "to": "opencode-tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "FB208",
        "repo": "OpenBidKit_Yibiao",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "assets/icon.icns",
      "identity": null,
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "background": "assets/macos-dmg/background.png",
      "iconSize": 88,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 170,
          "y": 360,
          "type": "file"
        },
        {
          "x": 520,
          "y": 360,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 112,
          "y": 318,
          "type": "file",
          "path": "assets/macos-dmg/macOS使用说明.txt",
          "name": "macOS使用说明.txt"
        }
      ]
    },
    "artifactName": "Yibiao-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.10.0",
    "cfb": "^1.2.2",
    "chardet": "^2.1.1",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "docx": "^9.6.1",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.2",
    "image-size": "^2.0.2",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.2.0",
    "markdown-it-cjk-friendly": "^2.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.14.0",
    "mime-types": "^3.0.2",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^7.25.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.0",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^41.10.2",
    "electron-builder": "^26.8.1",
    "js-yaml": "^4.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  }
}
